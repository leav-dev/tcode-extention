{
  "id": "tcode.autocomplete",
  "name": "Autocomplete",
  "version": "1.2.0",
  "activation": ["onStartup"],
  "contributes": {
    "commands": [
      {
        "id": "tcode.autocomplete.complete",
        "title": "Complete word from buffer",
        "script": "main.lua",
        "fn": "complete"
      }
    ],
    "keybindings": [
      { "key": "ctrl+space", "command": "tcode.autocomplete.complete" }
    ],
    "hooks": [],
    "suggest": {
      "script": "main.lua",
      "fn": "suggest"
    }
  }
}
