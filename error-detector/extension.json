{
  "id": "tcode.errordetector",
  "name": "Error Detector",
  "version": "2.0.0",
  "activation": ["onStartup"],
  "contributes": {
    "commands": [
      {
        "id": "tcode.errordetector.check",
        "title": "Detect errors",
        "script": "main.lua",
        "fn": "check"
      }
    ],
    "keybindings": [
      { "key": "alt+shift+e", "command": "tcode.errordetector.check" }
    ],
    "hooks": [
      { "event": "onDidSaveBuffer", "command": "tcode.errordetector.check" }
    ]
  }
}