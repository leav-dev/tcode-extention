{
  "id": "tcode.gitchanges",
  "name": "Git Changes",
  "version": "1.7.0",
  "activation": ["onStartup"],
  "contributes": {
    "commands": [
      {
        "id": "tcode.gitchanges.status",
        "title": "Show git changes summary",
        "script": "main.lua",
        "fn": "status"
      },
      {
        "id": "tcode.gitchanges.mark",
        "title": "Mark changed lines in gutter",
        "script": "main.lua",
        "fn": "mark"
      },
      {
        "id": "tcode.gitchanges.toggle",
        "title": "Toggle changed lines in gutter",
        "script": "main.lua",
        "fn": "toggle"
      },
      {
        "id": "tcode.gitchanges.all",
        "title": "Show git summary and mark changed lines",
        "script": "main.lua",
        "fn": "all"
      }
    ],
    "keybindings": [
      { "key": "alt+shift+g", "command": "tcode.gitchanges.status" },
      { "key": "alt+shift+m", "command": "tcode.gitchanges.mark" },
      { "key": "alt+shift+t", "command": "tcode.gitchanges.toggle" }
    ],
    "hooks": [
      { "event": "onDidSaveBuffer", "command": "tcode.gitchanges.all" }
    ]
  }
}
